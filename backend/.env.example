DATABASE_URL="postgresql://nodewave:nodewave@localhost:55432/nodewave?schema=public"

PORT=3000
NODE_ENV=development

# Auth
JWT_ACCESS_SECRET="dev-access-secret-change-me-in-production-min-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-in-production-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# CORS
# The API owns 3000 locally; the web app runs on 3001, so both are allowed.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001"

# Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# Standup background job
STANDUP_CRON_ENABLED=false
STANDUP_CRON_HOUR=7
